{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Siv3D: Build macOS",
			"type": "shell",
			"command": "${workspaceFolder}/macos/build-debug.sh",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "Siv3D: Run macOS",
			"type": "shell",
			"command": "${workspaceFolder}/macos/run-debug.sh",
			"problemMatcher": []
		},
		{
			"label": "Siv3D: Test Battle Card Interactions",
			"type": "shell",
			"command": "${workspaceFolder}/tests/run-battle-card-tests.sh",
			"problemMatcher": "$gcc"
		},
		{
			"label": "Siv3D: Build and Run macOS",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Siv3D: Build macOS",
				"Siv3D: Run macOS"
			],
			"problemMatcher": []
		}
	]
}
