{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build on macOS",
			"type": "shell",
			"command": "${workspaceFolder}/macos/build-debug.sh",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "Run on macOS",
			"type": "shell",
			"command": "${workspaceFolder}/macos/run-debug.sh",
			"problemMatcher": []
		},
		{
			"label": "Run Demo Mode on macOS",
			"type": "shell",
			"command": "${workspaceFolder}/macos/run-debug.sh",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build on macOS"
			],
			"args": [
				"--debug-midgame"
			],
			"problemMatcher": []
		},
		{
			"label": "Build and Run on macOS",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build on macOS",
				"Run on macOS"
			],
			"problemMatcher": []
		}
	]
}
