{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Siv3D: Build macOS",
			"type": "shell",
			"command": "xcodebuild",
			"args": [
				"-project",
				"${workspaceFolder}/macos/make10sion.xcodeproj",
				"-target",
				"make10sion",
				"-configuration",
				"Debug",
				"ARCHS=x86_64",
				"ONLY_ACTIVE_ARCH=YES",
				"build"
			],
			"problemMatcher": "$gcc"
		},
		{
			"label": "Siv3D: Run macOS",
			"type": "shell",
			"command": "./make10sion.app/Contents/MacOS/make10sion",
			"options": {
				"cwd": "${workspaceFolder}/macos/App"
			},
			"problemMatcher": []
		},
		{
			"label": "Siv3D: Build and Run macOS",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Siv3D: Build macOS",
				"Siv3D: Run macOS"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
